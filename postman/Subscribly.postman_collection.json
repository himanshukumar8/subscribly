          "name": "24 - Process Webhook Valid HMAC-SHA256 (Positive)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var orderId = pm.environment.get('gatewayOrderId') || 'order_sandbox_faa3c3dd82e3';",
                  "var eventId = 'evt_' + Date.now();",
                  "pm.environment.set('webhookEventId', eventId);",
                  "var paymentId = 'pay_' + Date.now();",
                  "var payload = JSON.stringify({",
                  "  \"eventId\": eventId,",
                  "  \"eventType\": \"payment.captured\",",
                  "  \"orderId\": orderId,",
                  "  \"paymentId\": paymentId,",
                  "  \"amount\": 49.99,",
                  "  \"currency\": \"INR\"",
                  "});",
                  "pm.environment.set('currentWebhookPayload', payload);",
                  "var secret = pm.environment.get('razorpayWebhookSecret') || 'rzp_test_mockWebhookSecret12345';",
                  "var hash = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.environment.set('computedWebhookSignature', hash);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook returns 200 OK', function () {",
