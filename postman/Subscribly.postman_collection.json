    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "03 - Register New User (Positive)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uniqueEmail = 'user_' + Date.now() + '@subscribly.test';",
                  "pm.environment.set('userEmail', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('JWT token is returned and saved', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.email).to.eql(pm.environment.get('userEmail'));",
                  "    pm.environment.set('userToken', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Automation User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
